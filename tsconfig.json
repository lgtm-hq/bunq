{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "useUnknownInCatchVariables": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "noEmitOnError": true,
    "skipLibCheck": false,
    "declaration": false,
    "composite": false,
    "types": [
      "node",
      "untrusted-json"
    ],
    "noEmit": true,
    "paths": {
      "@lgtm-hq/bunq-client": [
        "./packages/client/src/runtime.ts"
      ]
    },
    "typeRoots": [
      "./types",
      "./node_modules/@types"
    ]
  },
  "include": [
    "packages/*/src/**/*.ts"
  ]
}
